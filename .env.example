# Copy to .env and fill in real values (.env is gitignored)

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TEOS_FOUNDER_TELEGRAM_ID=

# Web session lifetime in hours (services/session.js). Issued at login and
# web-login; only the SHA-256 token hash is stored at rest. Defaults to 24h.
SESSION_TTL_HOURS=24

# PostgreSQL (Supabase-compatible connection string)
DATABASE_URL=postgres://user:password@host:port/database

# Workspace branding for the bot Home screen (reserved — not currently read)
WORKSPACE_NAME=

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# Dodo checkout URLs + product ids for the TEOS DealMaker pricing catalog
# (config/pricing.config.js). The code defaults to the live production
# checkout links — env overrides exist so staging/dev can point at test
# products without touching the source of truth. In normal operation these
# can stay unset.
DODO_STARTER_MONTHLY_URL=
DODO_STARTER_MONTHLY_PID=
DODO_STARTER_ANNUAL_URL=
DODO_STARTER_ANNUAL_PID=
DODO_GROWTH_MONTHLY_URL=
DODO_GROWTH_MONTHLY_PID=
DODO_GROWTH_ANNUAL_URL=
DODO_GROWTH_ANNUAL_PID=
DODO_BUSINESS_MONTHLY_URL=
DODO_BUSINESS_MONTHLY_PID=
DODO_BUSINESS_ANNUAL_URL=
DODO_BUSINESS_ANNUAL_PID=
DODO_ENTERPRISE_URL=

# TEOS Civic Mixer (MCP Gateway). MCP is optional — leave MCP_ENABLED unset to
# keep every tool call simulated and the platform running exactly as before.
MCP_ENABLED=false
MCP_ENDPOINT=
MCP_API_KEY=
MCP_TIMEOUT=15000

# TEOS Civic Mixer plugin (plugins/civic-mixer). Falls back to the MCP_* names
# above, so an existing gateway config keeps working unchanged.
CIVIC_MIXER_ENDPOINT=
CIVIC_MIXER_API_KEY=
CIVIC_MIXER_TIMEOUT=15000

# TEOS Sentinel Shield plugin (plugins/sentinel)
SENTINEL_ENDPOINT=
SENTINEL_API_KEY=
SENTINEL_TIMEOUT=15000

# Enterprise Platform Governance (services/platform). When enabled, the
# executeCapability() gate enforces tenant resolution, license/entitlement
# validity, plan capability scope, and RBAC authorization before any tool or
# plugin runs. Off by default — runtime behavior is unchanged.
TEOS_ENTERPRISE=false

# Public site URL used for canonical/OG tags and sitemap (server/index.js)
SITE_URL=https://dealmaker.elmahrosa.org

# Audit API protection (server/index.js). The /api/audit endpoint fails closed:
# it returns 503 until this key is set, and every request must present it in
# the X-API-Key header. Generate a long random value (e.g. openssl rand -hex 32).
AUDIT_API_KEY=

# Governed outbound email channel (services/emailChannel). Sending fails closed:
# every message must first pass explicit founder/mission approval, and no
# external call is ever made without a real Resend API key. Leave RESEND_API_KEY
# empty to keep the channel fully inert — the platform runs exactly as before.
# NEVER commit a real key here; generate one at https://resend.com and store it
# in the deployment secret store (e.g. Railway Variables).
RESEND_API_KEY=
# Canonical sender — the ONLY address ever used as the From header. Never use a
# Gmail address as sender. info@elmahrosa.org is the default even when unset.
EMAIL_FROM=info@elmahrosa.org
RESEND_TIMEOUT_MS=15000

# 24/7 governed outbound worker (services/outboundWorker). Persistent queue,
# approval-required, fail-closed, provider-confirmed. Default after deployment
# is PAUSED — the sender never starts RUNNING on its own. Founder resumes via
# the operations console only after OUTREACH_ENABLED=true is set.
# FOUNDER_REPORT_EMAIL is the founder's DESTINATION address for the ops report —
# it is never used as a sender and is never shown on the public health surface.
FOUNDER_REPORT_EMAIL=teosegy@gmail.com
RESEND_DOMAIN=elmahrosa.org
RESEND_WEBHOOK_SECRET=

# Legacy aliases (accepted as fallbacks only). Prefer the canonical names above.
#RESEND_FROM_EMAIL=info@elmahrosa.org
#FOUNDER_REPORT_TO=teosegy@gmail.com

# Rate / safety limits. When a limit is reached the worker pauses new outbound
# jobs (queued jobs are never deleted).
OUTREACH_DAILY_LIMIT=
OUTREACH_HOURLY_LIMIT=
PER_RECIPIENT_COOLDOWN_MINUTES=
MAX_RETRIES=
MAX_QUEUE_SIZE=

# Deployment switches. OUTREACH_ENABLED must be true before the founder can
# resume sending. OUTREACH_EMERGENCY_STOP is a hard kill switch that overrides
# everything. Never deploy a new sender in a RUNNING state.
OUTREACH_ENABLED=false
OUTREACH_EMERGENCY_STOP=false
OUTREACH_REQUIRE_VERIFIED_DOMAIN=true
OUTREACH_POLL_MS=5000

# Reverse-proxy hop count for rate limiting (server/index.js). Defaults to 1.
# Set to 0 when the server is directly exposed to the internet.
#TRUST_PROXY=1

# PostgreSQL TLS: certificate verification is ON by default. Only set this to
# "false" for a trusted private CA whose chain is not in the public trust store.
#PG_REJECT_UNAUTHORIZED=false

# Analytics (optional, injected into the landing page only when an id is set)
ANALYTICS_GA4=
ANALYTICS_CLARITY=
ANALYTICS_LINKEDIN=
ANALYTICS_META_PIXEL=

# ---------------------------------------------------------------------------
# Operational toggles (config/*, services/*, bot/*). All optional — defaults
# are the documented safe value. Keep these explicit when deploying a change:
# ---------------------------------------------------------------------------

# Bot identity + polling
BOT_NAME=
# Set "0" to run the bot in passive mode (no polling, no webhook deletion)
BOT_POLLING=

# Mode switches. TEOS_MODE gates agent side-effects (config/mode.js, DRY/LIVE).
# TEOS_DEFAULT_MODE is the per-workspace default used at seed time. APP_MODE
# controls the release notifier channel (services/notify.js, live/demo).
TEOS_MODE=DRY
TEOS_DEFAULT_MODE=DRY
APP_MODE=live

# Billing entitlement mode (config/billing.js). Leave unset for the standard
# Dodo webhook flow; set "manual_pilot" for entitlement without checkout.
#BILLING_MODE=

# Autonomous workflows (services/autoApproval.js). Defaults are conservative:
# nothing is auto-approved unless the team explicitly enables it.
#AUTO_APPROVAL_ENABLED=false
#AUTO_APPROVAL_COOLDOWN_HOURS=24
#AUTO_APPROVE_SCORE=
#AUTO_REJECT_BELOW=
#MAX_AUTO_APPROVES_PER_DAY=
#REQUIRE_FOUNDER_HIGH_VALUE=true
#FOUNDER_REVIEW_SCORE=
#HIGH_VALUE_THRESHOLD=

# Follow-up loop (services/followUpLoop)
#FOLLOW_UP_ENABLED=false
#FOLLOW_UP_DELAY_DAYS=5
#MAX_FOLLOW_UPS=2
#HOT_SCORE_THRESHOLD=80
#MEETING_READY_SCORE=70
#FOUNDER_ESCALATE_SCORE=85
#FOUNDER_ESCALATE_MIN_VALUE=5000
#COLD_AFTER_DAYS=30

# Outbound worker tuning (services/outboundWorker)
#OUTREACH_BATCH_SIZE=10
#OUTREACH_LEASE_MS=120000
#OUTREACH_RETRY_BASE_MS=10000
#OUTREACH_RETRY_MAX_MS=600000
#FOUNDER_ALERT_MIN_INTERVAL_MS=3600000
#AUTO_OUTREACH_ENABLED=false
#AUTO_OUTREACH_SCORE_THRESHOLD=80
#FOLLOW_UP_SCORE_THRESHOLD=70

# Revenue discovery / scheduler
#PROSPECT_DISCOVERY_ENABLED=false
#PIPELINE_HEALTH_ENABLED=true
#MISSION_SCHEDULER_ENABLED=true
#MISSION_SCHEDULER_INTERVAL_MS=1800000
#MISSION_SCHEDULER_MAX_CONCURRENT=2

# 24/7 Revenue Operations (SOR) — the master revenue-ops control plane
#SOR_ENABLED=false
#SOR_GATE=false
#SOR_REPORT_INTERVAL_HOURS=3
#SOR_MAX_BACKFILL_WINDOWS=1
#SOR_APPROVAL_TTL_HOURS=24
#SOR_APPROVAL_ALERT_THRESHOLD=5
#SOR_MAX_REPORT_RETRIES=3

# Release / ops notifications (services/notify.js) — inert until configured
#SLACK_WEBHOOK_URL=
#EMAIL_WEBHOOK_URL=
#EMAIL_CHANNEL=webhook
#EMAIL_TO=

# OAuth redirect for enterprise integrations (services/integrations/oauth.js)
#OAUTH_REDIRECT_URI=

# Provider + Postgres tuning
#PROVIDER_TIMEOUT_MS=30000
#PGSSLMODE=require
