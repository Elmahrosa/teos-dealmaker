# Copy to .env and fill in real values (.env is gitignored)

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TEOS_FOUNDER_TELEGRAM_ID=

# PostgreSQL (Supabase-compatible connection string)
DATABASE_URL=postgres://user:password@host:port/database

# Workspace branding for the bot Home screen
WORKSPACE_NAME=

# Dodo Payments
DODO_API_KEY=

# TEOS Civic Mixer (MCP Gateway). MCP is optional — leave MCP_ENABLED unset to
# keep every tool call simulated and the platform running exactly as before.
MCP_ENABLED=false
MCP_ENDPOINT=
MCP_API_KEY=
MCP_TIMEOUT=15000

# TEOS Civic Mixer plugin (plugins/civic-mixer). Falls back to the MCP_* names
# above, so an existing gateway config keeps working unchanged.
CIVIC_MIXER_ENDPOINT=
CIVIC_MIXER_API_KEY=
CIVIC_MIXER_TIMEOUT=15000

# TEOS Sentinel Shield plugin (plugins/sentinel)
SENTINEL_ENDPOINT=
SENTINEL_API_KEY=
SENTINEL_TIMEOUT=15000

# Enterprise Platform Governance (services/platform). When enabled, the
# executeCapability() gate enforces tenant resolution, license/entitlement
# validity, plan capability scope, and RBAC authorization before any tool or
# plugin runs. Off by default — runtime behavior is unchanged.
TEOS_ENTERPRISE=false
